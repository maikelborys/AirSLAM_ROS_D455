Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Image (features)1
        - /Path (odometry)1
        - /Mappoints (PointCloud)1
        - /Maplines (Marker)1
      Splitter Ratio: 0.55
    Tree Height: 800
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Color: 160; 160; 164
      Cell Size: 1
      Plane Cell Count: 50
      Plane: XY
      Reference Frame: map
      Enabled: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Frame Timeout: 15
      Frames:
        All Enabled: true

    - Class: rviz_default_plugins/Image
      Name: Image (features)
      Enabled: true
      Topic:
        Value: /AirSLAM/feature
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Median window: 5
      Min Value: 0
      Max Value: 1
      Normalize Range: true
      Value: true

    - Class: rviz_default_plugins/Path
      Name: Path (odometry)
      Enabled: true
      Topic:
        Value: /AirSLAM/odometry
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1.0
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None

    - Class: rviz_default_plugins/PoseArray
      Name: Keyframes (PoseArray)
      Enabled: true
      Topic:
        Value: /AirSLAM/keyframe
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.15
      Axes Radius: 0.02
      Color: 255; 25; 0
      Alpha: 1.0
      Arrow Length: 0.3

    - Class: rviz_default_plugins/Pose
      Name: Frame pose (current)
      Enabled: true
      Topic:
        Value: /AirSLAM/frame_pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.4
      Axes Radius: 0.04
      Color: 255; 255; 255
      Alpha: 1.0

    - Class: rviz_default_plugins/PointCloud
      Name: Mappoints (PointCloud)
      Enabled: true
      Topic:
        Value: /AirSLAM/map
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Size (m): 0.01
      Alpha: 1
      Color: 255; 200; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Use Fixed Frame: true
      Use rainbow: true

    - Class: rviz_default_plugins/Marker
      Name: Maplines (Marker)
      Enabled: true
      Topic:
        Value: /AirSLAM/mapline
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        "": true

    - Class: rviz_default_plugins/Odometry
      Name: Live Odometry
      Enabled: false
      Topic:
        Value: /AirSLAM/LatestOdometry
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Keep: 100
      Shape:
        Value: Arrow
        Color: 0; 200; 255
        Alpha: 1
        Shaft Length: 0.2
        Shaft Radius: 0.02
        Head Length: 0.07
        Head Radius: 0.04

    - Class: rviz_default_plugins/Marker
      Name: Reloc trajectory
      Enabled: true
      Topic:
        Value: /AirSLAM/reloc/trajectory
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        "": true

    - Class: rviz_default_plugins/Pose
      Name: Reloc pose
      Enabled: true
      Topic:
        Value: /AirSLAM/reloc/pose
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.5
      Axes Radius: 0.05
      Color: 0; 255; 200
      Alpha: 1.0

    - Class: rviz_default_plugins/Marker
      Name: Reloc matches
      Enabled: true
      Topic:
        Value: /AirSLAM/reloc/matches
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        "": true

  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable

  Transformation:
    Current:
      Class: rviz_default_plugins/TF

  Value: true

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Pitch: 0.785398   # ~45 deg
      Yaw: 0.785398
      Target Frame: <Fixed Frame>
      Invert Z Axis: false
      Near Clip Distance: 0.01

Window Geometry:
  Displays:
    collapsed: false
  Height: 1024
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 27
